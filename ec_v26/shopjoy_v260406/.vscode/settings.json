{
    // ── 테마 / 아이콘 (요청사항: "atom 테마 atom 아이콘") ─────────────────
    "workbench.colorTheme": "Atom One Dark",
    "workbench.iconTheme": "file-icons",
    // ── 메뉴바 항상 표시 (요청사항: "툴메뉴 Top에보이기") ────────────────
    // code-server(브라우저)는 기본적으로 햄버거 아이콘 뒤에 메뉴가 숨어있는 경우가 많아,
    // File/Edit/Selection/... 메뉴바를 상단에 항상 고정 표시.
    "window.menuBarVisibility": "classic",
    "eslint.format.enable": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "[javascript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[typescript]": {
        "editor.defaultFormatter": "dbaeumer.vscode-eslint"
    },
    "[vue]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    // ── Markdown 미리보기(요청사항: markdownviewer) ───────────────────
    "markdown.preview.breaks": true,
    "liveServer.settings.port": 5501,
    "liveServer.settings.ignoreFiles": [
        "apps/ecBeBo/**",
        "apps/ecBeCdn/**",
        "_doc/**",
        "log/**",
        "logs/**",
        "**/log/**",
        "**/logs/**",
        "**/*.md",
        "**/*.json",
        "**/*.py",
        "**/*.gradle",
        "**/*.kts",
        "**/*.bat",
        "**/*.java",
        "**/*.zip",
        "**/*.gz",
        "**/*.log",
        "**/*.jar",
        "**/*.bin",
        "**/*.xml",
        "**/*.properties",
        "**/*.lock",
        // 이미지 확장자 (소/대문자)
        "**/*.jpg",
        "**/*.JPG",
        "**/*.jpeg",
        "**/*.JPEG",
        "**/*.png",
        "**/*.PNG",
        "**/*.gif",
        "**/*.GIF",
        "**/*.webp",
        "**/*.WEBP",
        "**/*.bmp",
        "**/*.BMP",
        "**/*.svg",
        "**/*.SVG",
        "**/*.ico",
        "**/*.ICO",
        "**/*.tif",
        "**/*.tiff",
        "**/*.heic",
        "**/*.heif",
        "**/*.avif",
        // 동영상 확장자 (소/대문자)
        "**/*.mp4",
        "**/*.MP4",
        "**/*.avi",
        "**/*.AVI",
        "**/*.mov",
        "**/*.MOV",
        "**/*.mkv",
        "**/*.MKV",
        "**/*.webm",
        "**/*.WEBM",
        "**/*.flv",
        "**/*.FLV",
        "**/*.wmv",
        "**/*.WMV",
        "**/*.m4v",
        "**/*.M4V",
        "**/*.mpg",
        "**/*.mpeg",
        "**/*.3gp",
        // 엑셀·문서 확장자
        "**/*.pdf",
        "**/*.PDF",
        "**/*.doc",
        "**/*.DOC",
        "**/*.docx",
        "**/*.DOCX",
        "**/*.xls",
        "**/*.XLS",
        "**/*.xlsx",
        "**/*.XLSX",
        "**/*.xlsm",
        "**/*.XLSM",
        "**/*.xlsb",
        "**/*.csv",
        "**/*.CSV",
        "**/*.tsv",
        "**/*.ppt",
        "**/*.PPT",
        "**/*.pptx",
        "**/*.PPTX",
        "**/*.hwp",
        "**/*.HWP",
        "**/*.hwpx",
        "**/*.rtf",
        "**/*.odt",
        "**/*.ods",
        "**/*.odp",
        // 압축·기타 바이너리
        "**/*.zip",
        "**/*.ZIP",
        "**/*.7z",
        "**/*.7Z",
        "**/*.rar",
        "**/*.RAR",
        "**/*.tar",
        "**/*.tar.gz",
        "**/*.tgz",
        // 오디오
        "**/*.mp3",
        "**/*.wav",
        "**/*.flac",
        "**/*.aac",
        "**/*.ogg",
        "**/*.m4a",
        // 폰트
        "**/*.woff",
        "**/*.woff2",
        "**/*.ttf",
        "**/*.otf",
        "**/*.eot",
        "**/cdn/**",
        "**/uploads/**",
        "**/static/cdn/**",
        "**/bin/**",
        "**/bin/main/**",
        "**/node_modules/**",
        "**/.git/**",
        "**/.gradle/**",
        "**/.idea/**",
        "**/.vscode/**",
        "**/target/**",
        "**/build/**",
        "**/out/**",
        "**/dist/**"
    ],
    "java.compile.nullAnalysis.mode": "automatic",
    // ── IntelliJ ↔ VSCode 빌드 출력 충돌 방지 ──────────────────
    // VSCode Java 익스텐션이 자기만의 bin/main 을 만들면 IntelliJ/Gradle 빌드와 stale 충돌 발생
    // (FileNotFoundException: ...Repository.class cannot be opened 의 주범).
    // Gradle 위임 + 자동 빌드 OFF + IntelliJ 호환 import 로 통일.
    "java.import.gradle.enabled": true,
    "java.import.gradle.wrapper.enabled": true,
    "java.autobuild.enabled": false, // VSCode 자체 컴파일 비활성 (Gradle 만 사용)
    "java.configuration.maven.userSettings": null,
    "files.exclude": {
        "**/bin": true, // bin/ 은 VSCode 화면에서 숨김
        "**/.idea": true,
        "**/build/classes": true,
        "**/build/generated": true
    },
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/bin/**", // bin/ 은 import 대상에서 제외
        "**/out/**"
    ],
    // ⚠ 2026-09-07 정정 — 여기 원래 Windows 절대경로(C:\Users\illee\...)가 하드코딩돼
    // 있었는데, 이 파일은 git 추적 대상이라 리눅스 code-server 인스턴스에도 그대로
    // 딸려간다. 그 환경엔 그 경로가 없어서 Java 확장이 JDK를 못 찾는 에러가 난다 —
    // java.configuration.runtimes/java.jdt.ls.java.home 명시 경로를 아예 제거하고
    // JAVA_HOME/PATH로 자동 탐지하게 함(Windows 로컬은 JAVA_HOME 이미 설정돼 있고,
    // code-server는 apt install openjdk-17-jdk 후 자동 인식됨).
    "java.test.config": {
        "vmargs": [
            "-Duser.timezone=Asia/Seoul"
        ]
    },
    "liveServer.settings.CustomBrowser": "chrome",
    "liveServer.settings.file": "bo.html",
    "liveServer.settings.root": "/apps/ecFeBo",
    "liveServer.settings.useWebExt": false,
    "java.configuration.updateBuildConfiguration": "automatic"
}