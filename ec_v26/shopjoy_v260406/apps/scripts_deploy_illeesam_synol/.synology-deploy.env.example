# .synology-deploy.env 템플릿 — 실제 값을 채운 뒤 파일명을 ".synology-deploy.env" 로 바꿔서
# apps/scripts_deploy_illeesam_synol/ 폴더에 두세요.
#
# ⚠ 실제 계정정보(비밀번호 등)는 이 파일(.example)에 절대 채우지 마세요 — 이 파일은 git에
#   커밋되는 공개 템플릿입니다. 실제 값이 채워진 ".synology-deploy.env"(확장자 .example 없는
#   파일)는 .gitignore 에 등록되어 있어 커밋되지 않습니다.
#
# 실제 계정정보는 팀 내 별도 비밀관리 경로(사내 문서/전달)를 통해 확인하세요.

SYNOLOGY_HOST=illeesam.synology.me
SYNOLOGY_PORT=10022
SYNOLOGY_USER=여기에_실제_계정명_입력
SYNOLOGY_PASSWORD=여기에_실제_비밀번호_입력
