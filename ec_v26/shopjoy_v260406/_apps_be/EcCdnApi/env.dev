# EcCdnApi 예시 환경변수 파일 — 실제 NAS 배포용 .env(git 미추적, 직접 만들 것)의 참고 템플릿.
# EcAdminApi/env.dev 와 같은 역할: 이 파일 자체는 예시일 뿐 docker-compose 가 직접 읽지 않는다
# (docker-compose.yml 은 .env 를 읽음 — 아래 값을 참고해서 scripts 폴더가 아니라
#  _apps_be/EcCdnApi/.env 를 NAS 의 /volume1/docker/shopjoy/eccdnapi/ 에 직접 만들 것).

# ── DB (EcAdminApi 와 같은 Postgres 서버/스키마 — cf_* 전용 테이블만 새로 씀) ──
# ⚠ host.docker.internal 고정 — 컨테이너 안에서 illeesam.synology.me(공인 DDNS)로 붙으면
#   NAT 헤어핀으로 SocketTimeoutException 난다(docker-compose.yml extra_hosts 와 짝, 2026-09-06 실제로 겪음).
DB_HOST=host.docker.internal
DB_PORT=17632
DB_NAME=postgres
DB_SCHEMA=shopjoy_2604
DB_USERNAME=postgres
DB_PASSWORD=postgresilleesam

# ── JWT (accessToken 30초 고정 / refreshToken 7일) ──
# 운영은 로컬 더미 시크릿(application-local.yml)과 절대 같으면 안 됨 — 새로 발급해서 넣을 것.
CF_JWT_SECRET=bG9jYWwtb25seS1kdW1teS1zZWNyZXQtZm9yLWVjY2RuYXBpLWRvLW5vdC11c2UtaW4tcHJvZA==

# ── 파일 저장소 ──
CF_STORAGE_ROOT=/app/storage
CF_FFMPEG_PATH=ffmpeg

# ── 서버 ──
SERVER_PORT=3000
SPRING_PROFILES_ACTIVE=dev
